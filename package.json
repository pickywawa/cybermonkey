{
  "name": "cybermonkey",
  "productName": "Cybermonkey",
  "version": "1.2.0",
  "private": true,
  "description": "Mobile QA workspace with AI-assisted scenarios (Android & iOS)",
  "type": "module",
  "main": "dist-electron/main/bootstrap.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"tsc -p tsconfig.main.json --watch --preserveWatchOutput\" \"wait-on http://127.0.0.1:5273 dist-electron/main/index.js dist-electron/preload/index.cjs && node scripts/dev-electron.mjs\"",
    "dev:web": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.main.json",
    "build": "npm run typecheck && tsc -p tsconfig.main.json && vite build",
    "start": "electron .",
    "test": "tsx --test tests/*.test.ts",
    "icons": "node scripts/generate-icons.mjs",
    "dist": "npm run build && electron-builder --publish never",
    "test:package:mac": "node scripts/verify-macos-package.mjs",
    "site": "node scripts/build-site.mjs",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.312",
    "@github/copilot": "^1.0.103",
    "@github/copilot-sdk": "^1.0.26",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@openai/codex-sdk": "^0.164.0",
    "@xmldom/xmldom": "^0.9.12",
    "appium": "^3.8.0",
    "appium-uiautomator2-driver": "^8.7.0",
    "appium-xcuitest-driver": "^12.20.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0",
    "lucide-react": "^1.61.0",
    "prettier": "^3.9.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.0",
    "vite": "^8.3.5",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.pickywawa.cybermonkey",
    "productName": "Cybermonkey",
    "asarUnpack": [
      "node_modules/**/*"
    ],
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json",
      "!node_modules/@github/copilot-sdk-*/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg"
      ],
      "identity": "-",
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Cybermonkey-${version}-win-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "directories": {
      "output": "release"
    },
    "artifactName": "Cybermonkey-${version}-${os}-${arch}.${ext}",
    "npmRebuild": false,
    "publish": [
      {
        "provider": "github",
        "owner": "pickywawa",
        "repo": "cybermonkey"
      }
    ],
    "icon": "build/icon.png",
    "electronLanguages": [
      "en",
      "fr"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "afterSign": "scripts/verify-macos-package.mjs",
    "afterPack": "scripts/prepare-native-images.mjs",
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Cybermonkey"
    }
  },
  "overrides": {
    "zod": "$zod"
  },
  "author": {
    "name": "pickywawa"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "homepage": "https://pickywawa.github.io/cybermonkey/",
  "repository": {
    "type": "git",
    "url": "https://github.com/pickywawa/cybermonkey.git"
  },
  "optionalDependencies": {
    "@anthropic-ai/claude-agent-sdk-win32-x64": "0.3.312",
    "@esbuild/win32-x64": "0.28.2",
    "@github/copilot-sdk-win32-x64": "1.0.26",
    "@github/copilot-win32-x64": "1.0.103",
    "@img/sharp-win32-x64": "0.35.5",
    "@koromix/koffi-win32-x64": "3.2.1",
    "@openai/codex-win32-x64": "npm:@openai/codex@0.164.0-win32-x64",
    "@rolldown/binding-win32-x64-msvc": "1.2.15",
    "lightningcss-win32-x64-msvc": "1.33.0"
  }
}
